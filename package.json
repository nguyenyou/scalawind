{
  "name": "scalawind-monorepo",
  "private": true,
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "dev": "bun run --workspaces --if-present --parallel dev",
    "lint": "bun run --workspaces --if-present lint",
    "test": "bun run --workspaces --if-present test",
    "release": "changeset publish",
    "release:snapshot": "bun run version:snapshot && bun run publish:snapshot",
    "version:snapshot": "changeset version --snapshot snapshot",
    "publish:snapshot": "changeset publish --tag snapshot",
    "release:scalawind": "./mill -i scalawind.publishSonatypeCentral"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.3",
    "daisyui": "4.12.2",
    "tsup": "^6.5.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "website",
    "integration",
    "camelcase-integration"
  ],
  "trustedDependencies": [
    "esbuild"
  ]
}
